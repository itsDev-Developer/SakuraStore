# --- Telegram (https://my.telegram.org -> API development tools) ---
API_ID=123456
API_HASH=your_api_hash
# --- From @BotFather ---
BOT_TOKEN=123456:ABC...
# Channel the bot is ADMIN of: public @username (recommended) or numeric id (-100...)
CHANNEL=@TestCh
# --- Public HTTPS URL of the store ---
# Leave "auto" on Render / Koyeb (detected) and Termux (Cloudflare tunnel). Set it for Docker/VPS.
WEBAPP_URL=auto
# --- MongoDB ---
# Local: mongodb://localhost:27017   Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB=sakura
# --- Options ---
# Post text is translated to this language when it is not already ASCII/English. Empty = off.
TRANSLATE_TO=en
# Comma-separated Telegram user ids allowed to run /backfill
ADMIN_IDS=
# Domain for the bundled Caddy (docker compose only)
DOMAIN=store.example.com
